# Faultline configuration. Copy to .env (git-ignored) and edit.
# Precedence: process environment > this file > defaults in faultline/config.py.
# Empty values are ignored, so leaving a line blank keeps the default.

# ---------------------------------------------------------------- sandbox
# Docker Compose project name that Faultline is allowed to touch. Every container
# lookup is filtered by the label com.docker.compose.project=<this>, so nothing
# outside the project can be reached. deploy/docker-compose.yml uses "faultline".
# To attach to an already-running Ditto stack, set this to that project's name
# and adjust DITTO_USER / DITTO_PASSWORD below.
FAULTLINE_COMPOSE_PROJECT=faultline

# Ditto HTTP API as seen from the host (nginx entry point, basic auth).
DITTO_URL=http://127.0.0.1:8080
DITTO_USER=ditto
DITTO_PASSWORD=ditto

# Prometheus from deploy/docker-compose.yml (used for cross-checks and links).
PROMETHEUS_URL=http://127.0.0.1:9090

# ---------------------------------------------------------------- LLM
# Provider: ollama (local, open-source, default) | openai (any OpenAI-compatible
# chat API: OpenAI, Groq, OpenRouter, Together, ...) | anthropic
LLM_PROVIDER=ollama

# Model name for the provider. Empty = provider default
# (ollama: phi4-mini, openai: gpt-4o-mini, anthropic: see faultline/planning/llm.py).
# Other models installed on the demo laptop: qwen3.5:9b, gemma4
LLM_MODEL=phi4-mini

# Base URL. Empty = provider default
# (ollama: http://127.0.0.1:11434, openai: https://api.openai.com/v1, anthropic: https://api.anthropic.com).
# Examples: Groq https://api.groq.com/openai/v1, OpenRouter https://openrouter.ai/api/v1,
# Together https://api.together.xyz/v1
LLM_BASE_URL=

# API key for openai / anthropic providers. Not needed for ollama.
LLM_API_KEY=

# Set to false to run fully deterministic: no model is ever contacted, the
# planner takes the top-ranked candidate and all prose comes from templates.
FAULTLINE_LLM=true

# ---------------------------------------------------------------- approval gate
# The human-in-the-loop gate: Faultline emails one admin a closed set of replies
# and waits. Unset or unreachable is never consent -- the gate then applies its
# safe default (SKIP before an injection, CONTINUE after an experiment) instead
# of approving anything. Note that this file is read with a plain key=value
# parser, so an inline comment after a value would become part of the value.

# PLACEHOLDER -- who gets asked. There is no default and the address is
# deliberately not hardcoded anywhere in the code: the project owner has not
# supplied the real one yet. Leave it empty until they do, so that the agent's
# startup check and `faultline approvals` both report the gate as unconfigured
# rather than mailing a sample address. Sample form: admin@example.invalid
ADMIN_EMAIL=

# Outgoing mail for the request. Port 465 switches to implicit TLS and ignores
# SMTP_STARTTLS. SMTP_USER and SMTP_PASSWORD are never logged and never written
# into any file under reports/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# From header. Empty = SMTP_USER.
SMTP_FROM=

# Incoming mail, polled for the reply. A reply is matched by the correlation
# token FL-xxxxxxxx in the subject line, or by In-Reply-To pointing at the
# Message-ID Faultline sent -- never by "the newest unread mail", because two
# decisions can be open at once.
# Empty IMAP_HOST = SMTP_HOST; empty IMAP_USER / IMAP_PASSWORD = the SMTP ones.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SSL=true

# How long a decision stays open before the safe default is applied, and how
# often the mailbox is polled while waiting. The deadline is enforced by an
# independent watchdog timer on its own thread.
APPROVAL_TIMEOUT_SECONDS=120
APPROVAL_POLL_SECONDS=5

# ---------------------------------------------------------------- optional
# FAULTLINE_COMPOSE_FILE=deploy/docker-compose.yml
# FAULTLINE_REPORTS_DIR=reports
# FAULTLINE_NETWORK=            # default <project>_default

# Human-approved fixes: extra variables your stack's compose files need (e.g. one your launcher script exports)
# FAULTLINE_COMPOSE_ENV=DITTO_LOCAL_DIR=/path/to/ditto-local
# FIX_PROPOSAL_TIMEOUT_SECONDS=1800
