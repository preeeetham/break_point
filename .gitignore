# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Local configuration (secrets, API keys)
.env
targets/*/deploy/.env

# Blackboard output: every run writes here. Keep the directory, drop the contents.
reports/*
!reports/.gitkeep

# Incident Zero runtime state (incidents, events, evidence) and practice ground truth
.incident_zero/
.incident_zero_practice/

# Logs
*.log

# Editors / OS
.DS_Store
.idea/
.vscode/

# Onboarding: shallow clones of target repos
.cache/

# Claude frontend (claude-frontend/)
node_modules/

# Break Point-owned remediation override next to each target's compose file (runtime state, backed up
# under reports/remediation/)
docker-compose.override.yml
