# Eclipse Ditto image tag for all ditto-* services
DITTO_VERSION=3.9.8
# Host port (bound to 127.0.0.1) where nginx exposes the Ditto API/UI
DITTO_PORT=8080
# Password for the Ditto gateway /devops and /status endpoints (user: devops)
DEVOPS_PASSWORD=foobar
# Grafana admin password (anonymous viewer access is enabled regardless)
GRAFANA_ADMIN_PASSWORD=admin
